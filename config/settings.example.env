# Copy to config/settings.env
# Note: only needed for API mode; Skill/Agent mode works without reading these

# Anthropic-compatible gateway
ANTHROPIC_BASE_URL=https://your-gateway.example.com
ANTHROPIC_AUTH_TOKEN=your_token

# Must be a multimodal model with image input support (API mode)
VISION_MODEL=your-vision-model-name

# Frame extraction (shared by both modes)
FRAME_INTERVAL=0.33
MAX_FRAMES=36
